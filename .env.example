# ========================================================
# AI Legal Helper Environment Configuration
# ========================================================

# --- 1. AI Provider / LLM ---
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- 2. Database (PostgreSQL) ---
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_DB=ai_legal_helper
POSTGRES_TEST_DB=ai_legal_helper_test
DATABASE_URL=postgresql://ai_user:ai_password@postgres:5432/ai_legal_helper
TEST_DATABASE_URL=postgresql://ai_user:ai_password@127.0.0.1:5432/ai_legal_helper_test

# --- 3. Graph Database (Neo4j) ---
NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ai_password_dev

# --- 4. Vector Store (ChromaDB) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_HTTP_CLIENT=1

# --- 5. Application Settings ---
JWT_SECRET_KEY=ai-legal-helper-secret-key-for-dev-12345
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false

# --- 6. Storage Paths (Local Dev) ---
EVIDENCE_STORAGE_PATH=./storage/evidence
# --- 7. Langfuse Observability ---
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-12345
LANGFUSE_SECRET_KEY=sk-lf-12345
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_ENVIRONMENT=development
